{
  "name": "vsc-r-indent",
  "version": "0.1.0",
  "description": "On-type indentation adjustments for R",
  "displayName": "R Indent",
  "main": "./out/extension.js",
  "publisher": "ColinConwell",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "build:vsix": "npm run compile && npx --yes @vscode/vsce package --no-dependencies --out vsc-r-indent.vsix",
    "vscode:prepublish": "npm run compile",
    "install:local": "bash ./scripts/install-local.sh",
    "install:cursor": "bash ./scripts/install-local.sh --cursor"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColinConwell/VSC-R-Indent.git"
  },
  "keywords": [],
  "author": "developer@dev.com",
  "license": "MIT",
  "type": "module",
  "categories": [
    "Formatters"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onLanguage:r"
  ],
  "contributes": {

    "keybindings": [
      {
        "command": "type",
        "key": "enter",
        "when": "textInputFocus && editorLangId == 'r' && !editorReadonly && !suggestWidgetVisible",
        "args": { "text": "\n" }
      }
    ],
    "configuration": {
      "title": "R Indent",
      "properties": {
        "rIndent.enablePipeAlignment": {
          "type": "boolean",
          "default": true,
          "description": "Enable alignment for pipe operators (%>%, |>)"
        },
        "rIndent.pipeIndentSize": {
          "type": "number",
          "default": 2,
          "description": "Number of spaces to indent after pipe operators"
        },
        "rIndent.alignFunctionArguments": {
          "type": "boolean",
          "default": true,
          "description": "Align function arguments to opening parenthesis"
        },
        "rIndent.bracketAlignment": {
          "type": "string",
          "enum": ["afterBracket", "standardIndent"],
          "default": "afterBracket",
          "description": "How to align content after opening brackets"
        },
        "rIndent.rstudioCompatibility": {
          "type": "boolean",
          "default": true,
          "description": "Enable RStudio compatibility mode"
        },
        "rIndent.enableDebugLogging": {
          "type": "boolean",
          "default": true,
          "description": "Enable debug logging for development"
        },
        "rIndent.trimWhitespaceLines": {
          "type": "boolean",
          "default": false,
          "description": "Trim lines containing only whitespace"
        },
        "rIndent.useTabOnHangingIndent": {
          "type": "boolean",
          "default": false,
          "description": "Use tab character for hanging indents"
        },
        "rIndent.keepHangingBracketOnLine": {
          "type": "boolean",
          "default": false,
          "description": "Keep closing bracket on same line as last argument"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.11",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.9.2",
    "@vscode/vsce": "^3.21.0"
  },
  "bugs": {
    "url": "https://github.com/ColinConwell/VSC-R-Indent/issues"
  },
  "homepage": "https://github.com/ColinConwell/VSC-R-Indent#readme"
}
