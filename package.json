{
  "name": "vsc-r-indent",
  "version": "0.1.0",
  "description": "On-type indentation adjustments for R",
  "displayName": "R Indent",
  "icon": "R-Indent.png",
  "main": "./out/extension.js",
  "publisher": "ColinConwell",
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "build:vsix": "npm run compile && npx --yes @vscode/vsce package --no-dependencies --out vsc-r-indent.vsix",
    "vscode:prepublish": "npm run compile",
    "install:local": "bash ./scripts/install-local.sh",
    "install:cursor": "bash ./scripts/install-local.sh --cursor",
    "test:unit": "TS_NODE_PROJECT=tsconfig.tests.json mocha -r ts-node/register -r tsconfig-paths/register tests/unit/**/*.ts && mocha tests/headless-js/**/*.js && mocha tests/performance/**/*.js",
    "test:integration": "node ./out/tests/integration/runTest.js",
    "pretest": "npm run compile",
    "test": "npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColinConwell/VSC-R-Indent.git"
  },
  "keywords": [],
  "author": "developer@dev.com",
  "license": "MIT",
  "categories": [
    "Formatters"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onLanguage:r"
  ],
  "contributes": {
    "keybindings": [
      {
        "command": "type",
        "key": "enter",
        "when": "textInputFocus && editorLangId == 'r' && !editorReadonly && !suggestWidgetVisible",
        "args": {
          "text": "\n"
        }
      },
      {
        "command": "rIndent.toggleEngine",
        "key": "cmd+shift+9",
        "when": "editorLangId == 'r' && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "R Indent",
      "properties": {
        "rIndent.indentSize": {
          "type": "number",
          "default": 2,
          "description": "Number of spaces for base indentation (operator chains, brackets, etc.)"
        },
        "rIndent.alignFunctionArguments": {
          "type": "boolean",
          "default": true,
          "description": "Align function arguments to opening parenthesis"
        },
        "rIndent.enableDebugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable structured debug logging"
        },
        "rIndent.engine": {
          "type": "string",
          "enum": ["rules", "context", "air", "ast"],
          "default": "rules",
          "markdownDescription": "Select indentation engine: rules (current), context (planned parser), air (use Air formatter for on-type slice), ast (TypeScript AST-based emulation of Air style)."
        },
        "rIndent.airExecutablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional path to Air executable when using engine=air (overrides environment)."
        }
      }
    }
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.11",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "chai": "^4.5.0",
    "esmock": "^2.7.3",
    "glob": "^11.0.3",
    "mocha": "^10.7.3",
    "mock-require": "^3.0.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "bugs": {
    "url": "https://github.com/ColinConwell/VSC-R-Indent/issues"
  },
  "homepage": "https://github.com/ColinConwell/VSC-R-Indent#readme"
}
