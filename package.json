{
  "name": "rstudio-indent",
  "version": "0.2.0",
  "description": "RStudio-style indentation while typing R: aligned arguments, parameter values, and operator chains.",
  "displayName": "RStudio Indent",
  "icon": "R-Indent.png",
  "main": "./out/extension.js",
  "publisher": "ColinConwell",
  "scripts": {
    "compile": "node scripts/build.cjs",
    "watch": "tsc -w -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && npm run test:unit && npm run test:package",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:performance": "node tests/performance/benchmark.cjs",
    "test:package": "node scripts/check-package.cjs",
    "build:vsix": "vsce package --no-dependencies --out artifacts/rstudio-indent.vsix",
    "sandbox:up": "npm run build:vsix && docker compose up --build -d",
    "sandbox:down": "docker compose down",
    "sandbox:test": "node --test tests/browser/sandbox.test.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.cjs\" \"tests/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.cjs\" \"tests/**/*.cjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColinConwell/VSC-R-Indent.git"
  },
  "keywords": [
    "R",
    "RStudio",
    "indentation",
    "alignment",
    "Positron",
    "Cursor"
  ],
  "author": {
    "name": "Colin Conwell",
    "email": "colinconwell@gmail.com",
    "url": "https://github.com/ColinConwell"
  },
  "license": "GPL-3.0-only",
  "categories": [
    "Formatters"
  ],
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "activationEvents": [
    "onLanguage:r"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rIndent.enter",
        "title": "RStudio Indent: Insert Newline"
      },
      {
        "command": "rIndent.showRecentLogs",
        "title": "RStudio Indent: Show Logs"
      },
      {
        "command": "rIndent.toggleDebugLogging",
        "title": "RStudio Indent: Toggle Debug Logging"
      },
      {
        "command": "rIndent.toggleEngine",
        "title": "RStudio Indent: Explain Legacy Engine Settings"
      }
    ],
    "keybindings": [
      {
        "command": "rIndent.enter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == 'r' && !editorReadonly && !suggestWidgetVisible && !inSnippetMode && config.rIndent.enabled"
      }
    ],
    "configuration": {
      "title": "RStudio Indent",
      "properties": {
        "rIndent.indentSize": {
          "type": "integer",
          "default": 2,
          "description": "Number of spaces for base indentation (operator chains, brackets, etc.)",
          "minimum": 1,
          "maximum": 16,
          "scope": "language-overridable"
        },
        "rIndent.alignFunctionArguments": {
          "type": "boolean",
          "default": true,
          "description": "Align function arguments to opening parenthesis",
          "scope": "language-overridable"
        },
        "rIndent.enableDebugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable structured debug logging",
          "scope": "language-overridable"
        },
        "rIndent.showStatusBar": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show whether RStudio Indent is enabled. Click to open local diagnostic logs.",
          "scope": "language-overridable"
        },
        "rIndent.engine": {
          "type": "string",
          "enum": [
            "rules",
            "air",
            "ast"
          ],
          "default": "rules",
          "markdownDescription": "Legacy engine selection. All values now use the supported RStudio-style rules engine; no external executable is invoked.",
          "deprecationMessage": "Air and AST have been consolidated into the rules engine.",
          "scope": "language-overridable"
        },
        "rIndent.airExecutablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Retained for settings compatibility. This value is ignored; no Air executable is invoked.",
          "deprecationMessage": "Unused. RStudio Indent no longer executes Air.",
          "scope": "machine"
        },
        "rIndent.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable RStudio-style Enter and closing-bracket indentation.",
          "scope": "language-overridable"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "rIndent.enter",
          "when": "editorLangId == 'r'"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.0.0",
    "playwright": "1.63.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "bugs": {
    "url": "https://github.com/ColinConwell/VSC-R-Indent/issues"
  },
  "homepage": "https://github.com/ColinConwell/VSC-R-Indent#readme",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "extensionKind": [
    "workspace"
  ]
}
